{
  "name": "statsig-ld-migrator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @sslm/web dev",
    "build": "pnpm --filter @sslm/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run --project live",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures:generate": "pnpm --filter @sslm/demo-fixtures generate",
    "coverage:generate": "pnpm --filter @sslm/coverage generate",
    "test:live:write": "LIVE=1 LIVE_WRITE=1 vitest run --project live"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
