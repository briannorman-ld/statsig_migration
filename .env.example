# Copy to .env.local (gitignored). Used only by `pnpm test:live` (read-only LD calls).
# Never commit real tokens. The app itself never reads this file; tokens are entered in the UI
# and kept in memory.
LD_API_TOKEN=
# Optional: LD instance (us | eu | federal). Default: us.
LD_INSTANCE=us
# Optional: project to probe. Default: the first project the token can see.
LD_PROJECT_KEY=
