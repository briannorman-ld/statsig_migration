# Dependencies and build output
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo
.vercel/
.pnpm-store/

# OS / editor
.DS_Store
*.log
.idea/
*.swp

# Local, per-machine Claude Code config (absolute paths, personal permissions)
.claude/settings.local.json
.claude/launch.json

# Secrets: tokens live in .env.local for `pnpm test:live` only
.env*
!.env.example

# Reference repos are re-clonable via reference/fetch-repos.sh
reference/repos/

# Never commit real customer data: workspace exports, uploaded specs, captured API
# responses, raw-ID CSVs. These can contain PII and salts. Demo fixtures are synthetic.
*.sslm
real-specs/
captures/
*.raw-ids.csv
!packages/demo-fixtures/**/*.sslm
!packages/demo-fixtures/generated/**/*.raw-ids.csv
